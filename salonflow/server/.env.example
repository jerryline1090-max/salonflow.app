DATABASE_URL="postgresql://user:password@localhost:5432/salonflow"
PORT=4000
JWT_SECRET="change-me"
JWT_TTL="12h"
INTERNAL_API_KEY="change-me-too"
NODE_ENV="development"
# Comma-separated local browser origins. Production is locked to
# https://app.salonflow.com in server/src/index.ts.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# AI Receptionist channel integrations (see routes/webhooks.routes.ts)
META_APP_SECRET="your-meta-app-secret"           # used to verify WhatsApp + Instagram webhook signatures
WHATSAPP_VERIFY_TOKEN="your-chosen-verify-token"  # set when registering the WhatsApp webhook URL with Meta
INSTAGRAM_VERIFY_TOKEN="your-chosen-verify-token" # set when registering the Instagram webhook URL with Meta
# Per-business WhatsApp/Instagram access tokens are resolved via
# Integration.secretRef through SecretsProvider (see modules/ai/secretsProvider.ts),
# not a single global env var — see that file's dev-mode caveat.
# Development-only example: if an Integration.secretRef is WHATSAPP_TOKEN_BIZ1,
# EnvSecretsProvider resolves this matching variable. Never use a real token in
# this template; production must use a persistent secrets manager instead.
WHATSAPP_TOKEN_BIZ1="example-only-not-a-real-token"

# AI Receptionist connect/disconnect + language model
META_APP_ID="your-meta-app-id"
META_OAUTH_REDIRECT_URI="http://localhost:4000/api/integrations/whatsapp/callback" # register this exact URL (per provider) in the Meta App dashboard
OAUTH_STATE_SECRET="change-me-oauth-state-secret" # separate from JWT_SECRET on purpose — see core/oauthState.ts

# Powers both the internal assistant and AI Receptionist. Keep this server-side.
# Leave unset until billing/key setup is complete; the app then safely declines
# model-backed conversations rather than inventing answers or actions.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.6-luna"
# Optional feature overrides; each falls back to OPENAI_MODEL above.
OPENAI_ASSISTANT_MODEL=""
OPENAI_RECEPTIONIST_MODEL=""
OPENAI_VISION_MODEL=""
OPENAI_TRANSCRIPTION_MODEL=""

# Commercial billing (server-side only). Use dashboard plan codes from Paystack;
# never expose the secret key to the browser. Leave these placeholders unset until
# a controlled provider configuration is performed.
PAYSTACK_SECRET_KEY=""
PAYSTACK_STARTER_PLAN_CODE=""
PAYSTACK_GROWTH_PLAN_CODE=""
PAYSTACK_PRO_PLAN_CODE=""
# HTTPS app route used only as the hosted-checkout return destination. Webhook
# verification remains the sole authority for billing status.
PAYSTACK_CALLBACK_URL=""

# Reputation engine (section 30) — per-business overrides live in Settings;
# these are just the internal cron endpoints' shared secret, already
# covered by INTERNAL_API_KEY above. No additional env vars needed.

# Background job scheduler (see jobs/scheduler.ts) — runs in-process by
# default. Set to "false" on every instance except one if you run more
# than one copy of this API (see that file's multi-instance caveat).
ENABLE_SCHEDULER="true"
ENABLE_COMMERCIAL_LIFECYCLE_JOBS="false"
# Optional cron-expression overrides (defaults shown):
# CRON_ATTENTION_SCANNER="0 * * * *"     # hourly
# CRON_REPUTATION_QUEUE="*/30 * * * *"   # every 30 min
# CRON_REPUTATION_SEND="*/15 * * * *"    # every 15 min
# CRON_MEDIA_PURGE="0 3 * * *"           # daily at 3am
