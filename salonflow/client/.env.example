# Leave unset in development — vite.config.ts proxies /api to the backend.
# Set this for a production build where the frontend is served from a
# different origin than the API.
VITE_API_BASE_URL=/api
VITE_MARKETING_URL=https://salonflow.com
VITE_APP_URL=https://app.salonflow.com
VITE_DEMO_URL=https://demo.salonflow.com

# Dev-server proxy target only (see vite.config.ts) — not read by the app itself.
VITE_API_PROXY_TARGET=http://localhost:4000
